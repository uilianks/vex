{
  "name": "vex-vector-art",
  "version": "0.1.0",
  "private": true,
  "description": "A compact 2D vector game-asset DSL for AI agents and humans: sprites, scenes, anims, atlases as SVG + PNG, with a live viewer.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vex": "./bin/vex.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "examples": "node scripts/examples.ts",
    "check": "npm run typecheck && npm test && npm run examples"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uilianks/vex.git"
  },
  "homepage": "https://github.com/uilianks/vex#readme",
  "keywords": [
    "vector",
    "svg",
    "game-assets",
    "sprites",
    "sprite-sheet",
    "dsl",
    "gamedev",
    "ai-agent",
    "claude-code",
    "skill"
  ]
}
